{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "jsPlugins": ["./plugins/paragraphs.ts"],
  "categories": { "correctness": "error" },
  "rules": {
    "import/no-cycle": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "eslint/no-else-return": "error",
    "eslint/no-lonely-if": "error",
    "eslint/curly": ["error", "all"],
    "unicorn/no-lonely-if": "error",
    "eslint/no-warning-comments": ["error", { "terms": ["todo", "fixme", "hack", "xxx", "temp"], "location": "anywhere" }],
    "eslint/no-constant-condition": ["error", { "checkLoops": "all" }],
    "eslint/no-unmodified-loop-condition": "error",
    "eslint/no-sequences": ["error", { "allowInParentheses": false }],
    "eslint/max-depth": ["error", { "max": 4 }],
    "eslint/max-nested-callbacks": "error",
    "eslint/max-params": ["error", { "max": 4 }],
    "eslint/func-names": "error",
    "eslint/no-implicit-coercion": "error",
    "unicorn/no-array-reduce": "error",
    "unicorn/no-array-for-each": "error",
    "unicorn/no-unreadable-array-destructuring": "error",
    "unicorn/no-unreadable-iife": "error",
    "eslint/no-inline-comments": "error",
    "eslint/no-nested-ternary": "error",
    "eslint/complexity": ["error", { "max": 15 }],
    "eslint/max-lines-per-function": ["error", { "max": 100, "skipBlankLines": true, "skipComments": true }],
    "eslint/max-lines": ["error", { "max": 400, "skipBlankLines": true, "skipComments": true }],
    "paragraphs/declarations": "error",
    "paragraphs/guards": "error",
    "paragraphs/result": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.spec.ts"],
      "rules": { "eslint/max-lines-per-function": "off", "eslint/max-lines": "off" }
    }
  ]
}
