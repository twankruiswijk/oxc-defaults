{
  "name": "oxc-defaults",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "lint": "oxlint --type-aware --deny-warnings scripts plugins",
    "fmt": "oxfmt scripts plugins rules",
    "fmt:check": "oxfmt --check scripts plugins rules",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "readme": "node scripts/readme.ts",
    "check": "node scripts/check.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.92.0",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2"
  }
}
